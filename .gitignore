/target
# Per-crate cargo target dirs (e.g. the relative-path autotune cache
# `target/autotune/...` a `cargo run -p <crate>` example writes) — generated output.
crates/*/target/

# Bench data exports (quick 260620-d3v high-dim dataset) — large, regenerated by
# scripts/export_highdim_dataset.py; covered by /target but pinned explicitly.
target/bench_data/
*.highdim.tsv

__pycache__/

# Python virtual environment (Phase 8 toolchain)
/.venv/

# Built Python extension (maturin develop editable install) + pytest cache
crates/lgbm-python/python/lightgbm_rs/_core*.so
*.pyc
.pytest_cache/

# Read-only upstream reference trees — used locally for parity/FP-trace debugging,
# never part of the deliverable Rust crate (must never be committed/published).
/LightGBM/
/LightGBM-release-4.6.0.99/
/cuml-main/

# Local tooling caches
/.serena/
/.claude/worktrees/

# Kaggle output/push directories
/kaggle_*/
/kaggle_out*/
/kaggle_push*/
/kaggle_run*/
vendor/*/target/
