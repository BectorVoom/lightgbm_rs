{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./settings.schema.json",
  "title": "Planning Settings",
  "type": "object",
  "required": [
    "version",
    "models",
    "implementation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "object",
      "required": [
        "profile",
        "overrides"
      ],
      "properties": {
        "profile": {
          "enum": [
            "quality",
            "balanced",
            "budget",
            "custom"
          ]
        },
        "overrides": {
          "type": "object",
          "properties": {
            "planner": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "researcher": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "implementer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "verifier": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "required": [
        "use_worktree"
      ],
      "properties": {
        "use_worktree": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
